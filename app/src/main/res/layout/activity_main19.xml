<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="#C4E5EA"
    android:weightSum="13"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity19">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#90A9AC"
        android:layout_weight="7"
        android:paddingTop="50dp"
        android:paddingBottom="100dp"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="John Cooper"
            android:textSize="20dp"
            android:layout_margin="10dp"
            android:textColor="@color/black">
        </TextView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50:08"
            android:textSize="20dp"
            android:layout_margin="10dp"
            android:textColor="@color/black">

        </TextView>
        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@mipmap/boy3"
            android:textSize="20dp"
            android:layout_margin="10dp"
            android:textColor="@color/black">

        </TextView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:background="#90A9AC">
        <TextView
            android:layout_width="150dp"
            android:layout_height="200dp"
            android:background="@drawable/rec"
            android:backgroundTint="@color/white"
            android:layout_marginLeft="240dp"
            android:layout_marginBottom="30dp">

        </TextView>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#C4E5EA"
            android:layout_margin="20dp">
            <Button
                android:layout_width="200dp"
                android:layout_height="15dp"
                android:layout_margin="20dp"
                android:backgroundTint="#59787C">

            </Button>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="34dp"

            android:layout_marginBottom="10dp"
            android:background="#C4E5EA"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@mipmap/sp"
                >

            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="20dp"
                android:background="@mipmap/cam"
                >

            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="20dp"
                android:background="@mipmap/rev"
               >

            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="20dp"
                android:background="@mipmap/redcross"
                >

            </TextView>

        </LinearLayout>

    </LinearLayout>
</LinearLayout>