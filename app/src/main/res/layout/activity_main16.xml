<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C4E5EA"

    tools:context=".MainActivity16">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rec"
        android:backgroundTint="#03A9F4"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="30dp"

            >
            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:background="@drawable/baseline_arrow_back_24"
                android:textColor="@color/white"
                android:backgroundTint="@color/white"
                android:layout_marginLeft="30dp"

                >

            </TextView>
            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:background="@drawable/baseline_call_24"
                android:textColor="@color/white"
                android:backgroundTint="@color/white"
                android:layout_marginLeft="220dp"

                >

            </TextView>
            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:background="@drawable/baseline_camera_outdoor_24"
                android:textColor="@color/white"
                android:backgroundTint="@color/white"
                android:layout_marginLeft="20dp"

                >

            </TextView>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp"
            >


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Cooper's"
                android:textColor="@color/white"
                android:textSize="30dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                >

            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Community"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                >

            </TextView>
            <TextView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@mipmap/boy3"
                android:layout_marginTop="10dp"
                ></TextView>

        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rec"
            android:layout_marginTop="60dp"
            android:layout_marginRight="20dp"
            android:padding="10dp"
            android:layout_marginLeft="150dp"
            android:text="How was your experience with his
mentorship? Satisfied??"
            android:backgroundTint="#00BCD4"
            >

        </TextView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:background="@drawable/circle"

                android:backgroundTint="#009688"
                >

            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rec"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="20dp"
                android:backgroundTint="@color/white"
                android:text="Worth it!!"
                android:padding="10dp"
                android:textSize="15dp">

            </TextView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:background="@drawable/circle"

                android:backgroundTint="#C46BD3"
                >

            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rec"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="20dp"
                android:backgroundTint="@color/white"
                android:text="Impressive"
                android:padding="10dp"
                android:textSize="15dp">

            </TextView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10dp"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="20dp"
                android:background="@mipmap/boy5"


                >

            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rec"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="20dp"
                android:backgroundTint="@color/white"
                android:text="You’re missing out! Go take it!!!"
                android:padding="10dp"
                android:textSize="15dp">

            </TextView>
        </LinearLayout>
        <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:background="#147581"
            android:layout_marginTop="20dp"

            >
            <LinearLayout
                android:id="@+id/l1"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/rec"

                android:backgroundTint="#52BECC"
                >
                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginTop="5dp"
                    android:background="@mipmap/hot"
                    android:backgroundTint="@color/white"
                    >

                </TextView>
                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_margin="5dp"
                    android:backgroundTint="@color/white"
                    android:background="@mipmap/gaa"
                    >

                </TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type something..."
                    android:textColor="@color/white"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="10dp"
                    >

                </TextView>
                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="80dp"
                    android:layout_marginTop="5dp"
                    android:backgroundTint="@color/white"
                    android:background="@mipmap/cami"
                    >

                </TextView>
                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="10dp"
                    android:backgroundTint="@color/white"
                    android:background="@mipmap/spp"
                    >

                </TextView>
                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="10dp"
                    android:backgroundTint="@color/white"
                    android:layout_marginTop="5dp"
                    android:background="@mipmap/send2"
                    >

                </TextView>
            </LinearLayout>
            <TextView

                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@mipmap/plus"
                android:layout_marginTop="120dp"
                android:layout_centerInParent="true"
                >

            </TextView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:orientation="horizontal"
                android:layout_marginLeft="20dp"

                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/l1"
                >
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="50dp"
                    android:background="@drawable/baseline_bungalow_24"
                    android:backgroundTint="@color/white"

                    android:layout_marginLeft="10dp"
                    >

                </TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@mipmap/search"
                    android:backgroundTint="@color/white"
                    android:layout_marginLeft="20dp"
                    >

                </TextView>
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/baseline_chat_24"
                    android:backgroundTint="@color/white"
                    android:layout_marginLeft="120dp"
                    >

                </TextView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@mipmap/profile"
                    android:backgroundTint="@color/white"
                    android:layout_marginLeft="20dp"
                    >

                </TextView>



            </LinearLayout>
        </RelativeLayout>


    </LinearLayout>



    </LinearLayout>
</ScrollView>